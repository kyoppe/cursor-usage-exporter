# Datadog credentials and metric namespace for cursor-usage-exporter.
# Copy to ~/.cursor-usage-exporter/config.yaml and edit.
# Environment variables with the same names override this file.

DD_API_KEY: "your-datadog-api-key"
DD_SITE: datadoghq.com
METRIC_PREFIX: "your_namespace."

# Optional: tag metrics with Cursor chat UUID (increases Datadog cardinality).
# CONVERSATION_ID_TAG: true

# Optional: emit a Datadog Event when a new chat starts (beforeSubmitPrompt).
# Overlays as a pin on metric charts. Does not increase custom metric cardinality.
# CONVERSATION_START_EVENTS: true
